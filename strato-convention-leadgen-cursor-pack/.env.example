# Public canonical URL used for QR codes and public links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Google Apps Script web app endpoint
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SHARED_SECRET=

# Admin authentication: use a hash and a long random session secret
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Source label included in lead records
LEAD_SOURCE=STRATO Convention
