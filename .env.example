# Public canonical URL used for QR codes, shared card links, and origin checks.
# Set this to the deployed https origin before building production QR codes.
# NEXT_PUBLIC_ values are visible in the browser. Do not put secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must be the string "true" before /api/leads will forward enquiries.
# Leave false on preview deployments so test traffic cannot write to the production sheet.
LEAD_CAPTURE_ENABLED=false

# Server-only Google Apps Script web app endpoint (/exec URL).
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SHARED_SECRET=

# Admin authentication. Generate the hash with: npm run hash-admin-password -- "your-password"
# Never store the plaintext password. Use a long random session secret (32+ characters).
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Source label stored with each lead.
LEAD_SOURCE=STRATO Convention
